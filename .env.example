# 复制为 .env 后填写（stock init 会自动复制）。.env 不会提交到 git。

# LLM：config.yaml 中各 profile 的 api_key_env 指向这里的变量名
ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=

# 网页搜索 API（可选，填了哪个就优先用哪个；不填则只用免费搜索页，容易被限流）
# EXA_API_KEY=          # Exa https://dashboard.exa.ai/api-keys （不填则经 agent-reach 的 mcporter 用 Exa 免费额度，很快会被限流）
# BOCHA_API_KEY=        # 博查 https://open.bochaai.com ，中文内容覆盖好
# TAVILY_API_KEY=       # https://tavily.com
# SERPER_API_KEY=       # Google 搜索结果 https://serper.dev

# 推送（可选，填了哪个就推哪个）
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# FEISHU_SECRET=
# WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
# TELEGRAM_BOT_TOKEN=
